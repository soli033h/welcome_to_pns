---
import { company } from "../data/company";
import { homepage } from "../data/homepage";
---

<section class="contact-section section-pad" id="contact">
  <div class="container contact-grid">
    <div class="contact-copy reveal-up">
      <p class="eyebrow">{homepage.contact.eyebrow}</p>
      <h2 class="display-heading">{homepage.contact.heading.lead}<br /><em>{homepage.contact.heading.emphasis}</em></h2>
      <p class="body-copy">{homepage.contact.description}</p>
      <a class="contact-email" href={`mailto:${company.email}`}>{company.email}<span>{homepage.ui.externalLink}</span></a>
    </div>

    <form class="contact-form reveal-up" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden-field"><label>{homepage.contact.honeypotLabel} <input name="bot-field" /></label></p>
      <label>
        <span>{homepage.contact.fields.name.label}</span>
        <input type="text" name="name" placeholder={homepage.contact.fields.name.placeholder} required />
      </label>
      <label>
        <span>{homepage.contact.fields.email.label}</span>
        <input type="email" name="email" placeholder={homepage.contact.fields.email.placeholder} required />
      </label>
      <label>
        <span>{homepage.contact.fields.message.label}</span>
        <textarea name="message" rows="4" placeholder={homepage.contact.fields.message.placeholder} required></textarea>
      </label>
      <button class="submit-button" type="submit">{homepage.contact.submit} <span>{homepage.ui.externalLink}</span></button>
      <p class="form-note">{homepage.contact.formNote}</p>
    </form>
  </div>
</section>
