---
import { services, values } from "../data/company";
import { homepage } from "../data/homepage";
---

<section class="about-section section-pad" id="about">
  <div class="container">
    <div class="section-intro reveal-up">
      <p class="eyebrow">{homepage.about.eyebrow}</p>
      <h2 class="display-heading">{homepage.about.heading.lead}<br /><em>{homepage.about.heading.emphasis}</em></h2>
    </div>

    <div class="about-grid">
      <div class="about-statement reveal-up">
        <p class="large-copy">{homepage.about.statement}</p>
        <p class="body-copy">{homepage.about.description}</p>
      </div>
      <div class="service-list reveal-up">
        <p class="eyebrow">{homepage.about.servicesLabel}</p>
        <ul>
          {services.map((service, index) => <li><span>0{index + 1}</span>{service}</li>)}
        </ul>
      </div>
    </div>

    <div class="values-header reveal-up">
      <p class="eyebrow">{homepage.about.principlesLabel}</p>
      <span>{homepage.about.principlesProgress}</span>
    </div>
    <div class="values-grid">
      {values.map((value) => (
        <article class="value-item reveal-up" data-value-card>
          <span class="value-number">{value.number}</span>
          <h3>{value.title}</h3>
          <p>{value.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
