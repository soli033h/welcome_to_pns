---
import { projects } from "../data/projects";
import { homepage } from "../data/homepage";
---

<section class="work-section section-pad" id="work" data-work-section>
  <div class="container">
    <div class="work-heading reveal-up">
      <div>
        <p class="eyebrow">{homepage.work.eyebrow}</p>
        <h2 class="display-heading">{homepage.work.heading.lead}<br /><em>{homepage.work.heading.emphasis}</em></h2>
      </div>
      <p class="work-note">{homepage.work.note[0]}<br />{homepage.work.note[1]}</p>
    </div>
  </div>

  <div class="project-list">
    {projects.map((project) => (
      <article class="project-card" style={`--project-accent: ${project.accent}`}>
        <div class="project-image-wrap">
          <div class="project-slides" data-slider>
            {project.images.map((image, imageIndex) => (
              <img
                class:list={{ "project-slide": true, "is-active": imageIndex === 0 }}
                src={image}
                alt={homepage.work.imageViewLabel(project.client, imageIndex)}
                loading={imageIndex === 0 ? "lazy" : "eager"}
                aria-hidden={imageIndex === 0 ? undefined : "true"}
              />
            ))}
          </div>
          <div class="project-wash"></div>
          <span class="project-index">{project.index}</span>
          <span class="project-arrow" aria-hidden="true">{homepage.ui.externalLink}</span>
          <div class="project-pagination" aria-label={homepage.work.imageViewsLabel(project.client)}>
            {project.images.map((_, imageIndex) => (
              <button
                class:list={{ "is-active": imageIndex === 0 }}
                type="button"
                data-slide-target={imageIndex}
                aria-label={homepage.work.showImageLabel(imageIndex)}
                aria-current={imageIndex === 0 ? "true" : undefined}
              ></button>
            ))}
          </div>
        </div>
        <div class="project-meta">
          <div>
            <p class="project-client">{project.client}</p>
            <h3>{project.title}</h3>
          </div>
          <div class="project-details">
            <span>{project.category}</span>
            <span>{project.year}</span>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
