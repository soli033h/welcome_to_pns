---
import { company } from "../data/company";
import { navigation } from "../data/navigation";
---

<header class="site-header" data-header>
  <a class="brand-mark" href="#top" aria-label={`${company.name} home`}>
    <span class="brand-dot"></span>
    <span>{company.name}</span>
  </a>

  <nav class="desktop-nav" aria-label="Main navigation">
    {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <a class="header-cta" href="#contact">
    <span>Start a project</span>
    <span aria-hidden="true">↗</span>
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
    <span class="sr-only">Open menu</span>
    <span></span><span></span>
  </button>
  <span class="scroll-progress" aria-hidden="true"></span>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <nav aria-label="Mobile navigation">
    {navigation.map((item) => <a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a>)}
  </nav>
</div>
