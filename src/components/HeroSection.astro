---
import { company } from "../data/company";
import { homepage } from "../data/homepage";
---

<section class="hero-section" id="top" data-section="hero">
  <div class="hero-media" aria-hidden="true">
    <div class="hero-orbit orbit-one"></div>
    <div class="hero-orbit orbit-two"></div>
    <div class="hero-grid"></div>
    <span class="hero-coordinate">{homepage.hero.coordinates[0]}<br />{homepage.hero.coordinates[1]}</span>
  </div>

  <div class="hero-content container">
    <p class="eyebrow hero-eyebrow">{homepage.hero.eyebrow}</p>
    <h1 class="hero-title" data-split-text>{company.tagline}</h1>
    <div class="hero-bottomline">
      <p>{company.description}</p>
      <a class="circle-link" href="#about" aria-label={homepage.hero.discoverLabel}>
        <span>{homepage.ui.discover}</span>
      </a>
    </div>
  </div>

  <div class="hero-footer container">
    <span>{homepage.hero.scrollLabel}</span>
    <span class="hero-line"></span>
    <span>{homepage.hero.progress}</span>
  </div>
</section>
